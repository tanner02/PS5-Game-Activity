set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_VERSION 12.0)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(PBS_PS5 ON CACHE BOOL "Build a PS5 payload" FORCE)
if(NOT DEFINED ENV{PS5_PAYLOAD_SDK})
    message(FATAL_ERROR "Set PS5_PAYLOAD_SDK to the Linux/WSL SDK path")
endif()
file(TO_CMAKE_PATH "$ENV{PS5_PAYLOAD_SDK}" PS5_PAYLOAD_SDK)
if(NOT EXISTS "${PS5_PAYLOAD_SDK}/target/lib/main.script")
    message(FATAL_ERROR "PS5_PAYLOAD_SDK does not contain target/lib/main.script")
endif()
get_filename_component(_pbs_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(CMAKE_C_COMPILER "${_pbs_root}/scripts/ps5-cc")
set(CMAKE_CXX_COMPILER "${_pbs_root}/scripts/ps5-cxx")
find_program(CMAKE_AR NAMES llvm-ar llvm-ar-21 llvm-ar-20 llvm-ar-19 REQUIRED)
find_program(CMAKE_RANLIB NAMES llvm-ranlib llvm-ranlib-21 llvm-ranlib-20 llvm-ranlib-19 REQUIRED)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(PS5_DEPS_PREFIX "${_pbs_root}/build/ps5-deps" CACHE PATH "PS5 static dependency prefix")
set(CMAKE_FIND_ROOT_PATH "${PS5_DEPS_PREFIX}" "${PS5_PAYLOAD_SDK}/target")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
list(PREPEND CMAKE_PREFIX_PATH "${PS5_DEPS_PREFIX}")
set(OPENSSL_ROOT_DIR "${PS5_DEPS_PREFIX}" CACHE PATH "")
set(OPENSSL_USE_STATIC_LIBS TRUE)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
